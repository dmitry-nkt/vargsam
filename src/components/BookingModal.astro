---
import { site } from '../content/site';
import SocialButtons from './SocialButtons.astro';

const { bookingModal, brand, social } = site;
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---

<dialog class="booking-dialog" id="booking-dialog" aria-labelledby="booking-dialog-title">
  <div class="booking-dialog__panel">
    <button type="button" class="booking-dialog__close" aria-label="Закрыть" data-booking-close>
      ×
    </button>
    <h2 id="booking-dialog-title" class="booking-dialog__title">
      {bookingModal.title}
      <span class="booking-dialog__subtitle">{bookingModal.subtitle}</span>
    </h2>
    <form class="booking-form" id="booking-form" novalidate>
      <label class="booking-field">
        <span>{bookingModal.nameLabel}</span>
        <input name="name" type="text" autocomplete="name" required maxlength="120" />
      </label>
      <label class="booking-field">
        <span>{bookingModal.phoneLabel}</span>
        <input name="phone" type="text" autocomplete="tel" required maxlength="80" />
      </label>
      <fieldset class="booking-fieldset">
        <legend>{bookingModal.channelLegend}</legend>
        <div class="booking-radios">
          {bookingModal.channels.map((c) => (
            <label class="booking-radio">
              <input type="radio" name="channel" value={c.value} required />
              <span>{c.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <p class="booking-form-feedback" id="booking-feedback" role="status" aria-live="polite" hidden />
      <button type="submit" class="btn booking-submit" id="booking-submit">
        {bookingModal.submit}
      </button>
    </form>
    <p class="booking-communities-caption">{bookingModal.communitiesCaption}</p>
    <SocialButtons social={social} />
  </div>
</dialog>

<script
  define:vars={{
    email: brand.email,
    web3formsKey,
    formSubject: 'Запись на первичную консультацию',
  }}
>
  const dialog = document.getElementById('booking-dialog');
  const openers = document.querySelectorAll('[data-open-booking]');
  const closers = document.querySelectorAll('[data-booking-close]');
  const form = document.getElementById('booking-form');
  const feedback = document.getElementById('booking-feedback');
  const submitBtn = document.getElementById('booking-submit');

  function setFeedback(text, kind) {
    if (!feedback) return;
    feedback.hidden = !text;
    feedback.textContent = text || '';
    feedback.classList.remove('booking-form-feedback--ok', 'booking-form-feedback--error');
    if (kind === 'ok') feedback.classList.add('booking-form-feedback--ok');
    if (kind === 'error') feedback.classList.add('booking-form-feedback--error');
  }

  openers.forEach((el) => {
    el.addEventListener('click', () => {
      setFeedback('', null);
      dialog?.showModal();
    });
  });

  closers.forEach((el) => {
    el.addEventListener('click', () => dialog?.close());
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dialog?.open) dialog.close();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const name = String(fd.get('name') || '').trim();
    const phone = String(fd.get('phone') || '').trim();
    const channel = String(fd.get('channel') || '').trim();
    if (!name || !phone || !channel) return;

    const key = typeof web3formsKey === 'string' ? web3formsKey.trim() : '';

    if (key) {
      const originalLabel = submitBtn?.textContent ?? '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Отправка…';
      }
      setFeedback('Отправляем…', null);
      try {
        const body = new FormData();
        body.append('access_key', key);
        body.append('subject', formSubject);
        body.append('name', name);
        body.append('phone', phone);
        body.append(
          'message',
          `Имя: ${name}\nТелефон или ID: ${phone}\nКуда написать: ${channel}`,
        );

        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body,
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          setFeedback('Спасибо! Заявка отправлена — скоро свяжусь с вами.', 'ok');
          form.reset();
          window.setTimeout(() => {
            dialog?.close();
            setFeedback('', null);
          }, 2200);
        } else {
          throw new Error(typeof data.message === 'string' ? data.message : 'Ошибка сервиса');
        }
      } catch {
        setFeedback(
          'Не удалось отправить заявку. Позвоните или напишите в Telegram / VK — ссылки ниже.',
          'error',
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
      return;
    }

    const subject = encodeURIComponent(formSubject);
    const body = encodeURIComponent(
      `Имя: ${name}\nТелефон или ID: ${phone}\nКанал связи: ${channel}\n`,
    );
    setFeedback('Откроется почта для отправки… Если почты нет, добавьте ключ Web3Forms (см. .env.example).', null);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
