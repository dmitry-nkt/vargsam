---
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
const cookiePolicyHref = `${basePath}docs/politika-cookie.pdf`;
const privacyPolicyHref = `${basePath}docs/politika-konfidencialnosti.pdf`;
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="region"
  aria-label="Уведомление об использовании cookie"
>
  <div class="cookie-banner__inner">
    <p class="cookie-banner__text">
      Сайт использует файлы <strong>cookie</strong> и аналогичные технологии (в том числе локальное хранилище
      браузера) для корректной работы страниц, сохранения настроек и учёта посещаемости. Обработка сведений
      осуществляется в соответствии с{' '}
      <a href={privacyPolicyHref} target="_blank" rel="noopener noreferrer">Политикой конфиденциальности</a>
      {' '}и{' '}
      <a href={cookiePolicyHref} target="_blank" rel="noopener noreferrer">Политикой использования cookie</a>
      , на основании{' '}
      <abbr title="Федеральный закон от 27.07.2006 № 152-ФЗ">152-ФЗ</abbr> «О персональных данных». Нажимая
      «Принять», вы подтверждаете согласие на указанную обработку.
    </p>
    <div class="cookie-banner__actions">
      <button type="button" class="btn cookie-banner__accept" id="cookie-banner-accept">
        Принять
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'vargsam_cookie_v1';

  function hideBanner() {
    document.documentElement.classList.add('cookie-consent-done');
  }

  document.getElementById('cookie-banner-accept')?.addEventListener('click', () => {
    try {
      localStorage.setItem(STORAGE_KEY, '1');
    } catch {
      /* private mode */
    }
    hideBanner();
  });
</script>
