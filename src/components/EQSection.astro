---
const { site } = Astro.props as {
  site: typeof import('../content/site').site;
};
---

<section class="section" id="help" aria-label="С чем помогаю">
  <div class="container">
    <div class="eqwrap">
      <div class="section__head section__head--split">
        <div class="section__head-main">
          <h2 class="eq-title">{site.eq.title}</h2>
          <p class="eq-description">{site.eq.description}</p>
        </div>
        <p class="section-kicker-muted">{site.eq.sectionKicker}</p>
      </div>

      <div class="grid-3">
        {site.eq.cards.map((c) => (
          <div class="card eq-card">
            <h3>{c.title}</h3>
            <p>{c.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
