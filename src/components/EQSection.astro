---
import CheckIcon from './CheckIcon.astro';

const {site} = Astro.props as {
  site: {
    eq: {
      title: string;
      description: string;
      cards: Array<{title: string; description: string}>;
    };
  };
};
---

<section class="section" id="help" aria-label="С чем помогу">
  <div class="container">
    <div class="eqwrap">
      <div class="section__head">
        <div>
          <div class="kicker">С чем помогаю</div>
          <h2>{site.eq.title}</h2>
          <p class="sub">{site.eq.description}</p>
        </div>
      </div>

      <div class="grid-3">
        {site.eq.cards.map((c) => (
          <div class="card eq-card">
            <h3>{c.title}</h3>
            <p>{c.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

