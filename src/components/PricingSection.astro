---
const { site } = Astro.props as {
  site: typeof import('../content/site').site;
};
---

<section class="section" id="pricing" aria-label="Стоимость">
  <div class="container">
    <div class="section__head section__head--split">
      <div class="section__head-main">
        <h2 class="pricing-title">{site.pricing.title}</h2>
      </div>
      <p class="section-kicker-muted">{site.pricing.sectionKicker}</p>
    </div>

    <div class="price-list">
      {site.pricing.items.map((item) => (
        <div class="price-item">
          <div class="price-item__top">
            <strong class="price-item__name">{item.title}</strong>
            <div class="price-meta">{item.meta}</div>
          </div>

          <ul class="price-bullets">
            {item.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>

          {item.note && <p class="price-note">{item.note}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
