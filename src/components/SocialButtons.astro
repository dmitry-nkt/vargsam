---
const {social} = Astro.props as {social: Array<{kind: string; href: string; label: string}>};
---

<div class="socialrow" aria-label="Социальные сети">
  {social.filter((s) => Boolean(s.href) && s.href !== '#').map((s) => (
    <a
      class="socialbtn"
      href={s.href}
      target="_blank"
      rel="noreferrer noopener"
      aria-label={s.label}
    >
      {s.kind === 'telegram' && (
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21.5 4.5L3.8 11.2c-.7.3-.7 1.3.1 1.5l4.6 1.5 1.8 5.6c.2.6.9.7 1.3.2l2.6-3.1 4.7 3.5c.5.4 1.2.1 1.3-.6l3-17.5c.1-.7-.6-1.2-1.3-.9Z" />
        </svg>
      )}
      {s.kind === 'vk' && (
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4 7h3.2c.4 0 .7.3.7.7 0 3 1.1 5.7 2.4 5.7.7 0 1-1.4 1-2.8V7.7c0-.4.3-.7.7-.7h3c.4 0 .7.3.7.7v1.2c0 1.4.3 2.8 1 2.8 1.3 0 2.4-2.7 2.4-5.7 0-.4.3-.7.7-.7H20c.4 0 .7.3.7.7 0 7.1-4.3 10.3-7 10.3-1.6 0-2.6-.8-3.1-1.5-.5.7-1.5 1.5-3.1 1.5-2.7 0-7-3.2-7-10.3 0-.4.3-.7.7-.7Z" />
        </svg>
      )}
      {s.kind === 'youtube' && (
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21.6 7.2c.2.8.4 1.9.4 4.8s-.2 4-.4 4.8c-.2.9-1 1.6-2 1.8-1.7.3-4.4.4-7.6.4s-5.9-.1-7.6-.4c-1-.2-1.8-.9-2-1.8C2.2 16 2 14.9 2 12s.2-4 .4-4.8c.2-.9 1-1.6 2-1.8C6.1 5.1 8.8 5 12 5s5.9.1 7.6.4c1 .2 1.8.9 2 1.8ZM10 15l6-3-6-3v6Z" />
        </svg>
      )}
    </a>
  ))}
</div>

