---
import type { SimpleIcon } from 'simple-icons';
import { siTelegram, siVk, siYoutube } from 'simple-icons';

const { social } = Astro.props as { social: Array<{ kind: string; href: string; label: string }> };

const iconByKind: Record<string, SimpleIcon> = {
  telegram: siTelegram,
  vk: siVk,
  youtube: siYoutube,
};
---

<div class="socialrow" aria-label="Социальные сети">
  {
    social
      .filter((s) => Boolean(s.href) && s.href !== '#')
      .map((s) => {
        const icon = iconByKind[s.kind];
        if (!icon) return null;
        return (
          <a
            class="socialbtn"
            href={s.href}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={s.label}
            style={`--si-brand: #${icon.hex};`}
          >
            <svg class="socialbtn__svg" viewBox="0 0 24 24" aria-hidden="true" role="img">
              <path fill="currentColor" d={icon.path} />
            </svg>
          </a>
        );
      })
  }
</div>

