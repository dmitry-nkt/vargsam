---
const {site} = Astro.props as {
  site: {
    testimonials: Array<{name: string; date: string; rating: number; text: string}>;
  };
};
---

<section class="section" id="testimonials" aria-label="Отзывы">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="kicker">Отзывы</div>
        <h2>Здесь лента отзывов</h2>
        <p class="sub">Ниже — мнения клиентов после практик и сеансов.</p>
      </div>
    </div>

    <div class="reviews-grid">
      {site.testimonials.map((t) => (
        <article class="review">
          <div class="review__head">
            <div class="avatar" aria-hidden="true">
              {t.name
                .split(' ')
                .filter(Boolean)
                .slice(0, 2)
                .map((p) => p[0])
                .join('')}
            </div>
            <div class="review__title">
              <strong>{t.name}</strong>
              <span>{t.date}</span>
            </div>
            <div class="stars" aria-label={`Оценка ${t.rating} из 5`}>
              {Array.from({length: 5}, (_, i) => {
                const filled = i < t.rating;
                return (
                  <svg
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    focusable="false"
                    style={{
                      fill: filled ? '#f59e0b' : 'rgba(245, 158, 11, 0.28)',
                    }}
                  >
                    <path
                      d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                    />
                  </svg>
                );
              })}
            </div>
          </div>
          <p>{t.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

