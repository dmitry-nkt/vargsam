---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

const {
  title = 'Scenax',
  description = '',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      try {
        if (localStorage.getItem('vargsam_cookie_v1') === '1') {
          document.documentElement.classList.add('cookie-consent-done');
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>

