---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import HeroSection from '../components/HeroSection.astro';
import EQSection from '../components/EQSection.astro';
import PricingSection from '../components/PricingSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import BookingModal from '../components/BookingModal.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;

const pageTitle = 'Психолог-гипнолог Варганова — Самара: очно и онлайн';
const pageDescription =
  'Консультации психолога-гипнолога в Самаре: регрессивный гипноз, EQ, игра Лила, расстановки. Первичная консультация 1 час — 0 ₽.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <LocalBusinessSchema slot="head" />
  <header class="topbar">
    <div class="container topbar__inner">
      <a class="brand" href={`${basePath}#top`} aria-label="На главный экран">
        <span class="brand__mark" aria-hidden="true">
          <img src={`${basePath}assets/logo.png`} width="44" height="44" alt="" />
        </span>
        <span class="brand__title">
          <strong class="brand__name">{site.brand.title}</strong>
          <a class="brand__phone" href={`tel:${site.brand.phoneTel}`}>{site.brand.phoneDisplay}</a>
        </span>
      </a>

      <nav class="nav" aria-label="Навигация по странице">
        {site.nav.map((n) => (
          <a href={`#${n.id}`}>{n.label}</a>
        ))}
      </nav>

      <button type="button" class="btn" data-open-booking>
        {site.hero.cta}
      </button>
    </div>
  </header>

  <BookingModal />

  <main>
    <HeroSection site={site} social={site.social} />
    <EQSection site={site} />
    <PricingSection site={site} />
    <TestimonialsSection site={site} />

    <SiteFooter />
  </main>
</BaseLayout>
